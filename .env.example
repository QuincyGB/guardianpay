# GuardianPay sandbox configuration — copy to .env and fill in.
# Get these free at https://developer.paypal.com → Apps & Credentials → Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: sandbox business email used as the invoice sender
PAYPAL_MERCHANT_EMAIL=
# Optional: enables real webhook signature verification
PAYPAL_WEBHOOK_ID=
# Optional: upgrades message analysis from heuristic to a real LLM call
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: fallback LLM provider if OpenAI is unset or fails (tried after OpenAI)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Optional: real SMS alerts to the trusted contact via Twilio.
# Without these, the demo shows a labeled UI mock (no messages leave the machine).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=  # your Twilio phone number, e.g. +14165550100
PORT=3000
